import 'reflect-metadata';import assert from 'node:assert/strict';import {randomUUID} from 'node:crypto';
import {bootPostgres} from './pg-harness/wire-session.mjs';import {PrismaClient} from '@prisma/client';import {PrismaPg} from '@prisma/adapter-pg';
import {seedBrowserProductionFixture} from './production.fixture.js';import {ProductionOfferService} from '../src/modules/procurement/production-offers.js';import {ProductionPlanningService} from '../src/modules/procurement/planning.js';import {CommerceService} from '../src/modules/commerce/commerce.service.js';import {projectCapacity} from '../src/modules/artisans/capacity.js';
const env=await bootPostgres();const db=new PrismaClient({adapter:new PrismaPg({connectionString:env.connectionString})});const offers=new ProductionOfferService(db as never),commerce=new CommerceService(db as never,{} as never),planning=new ProductionPlanningService(db as never,offers);const results:any[]=[];
async function result(fn:()=>Promise<any>){try{return {ok:true,value:await fn()}}catch(e:any){return {ok:false,code:e.response?.code,message:e.response?.message??e.message,status:e.status}}}
async function fixture(suffix:string){
 const users:any={};for(const role of ['operator','artisan','coordinator']){const u=await db.user.create({data:{id:randomUUID(),email:`production-${role}-${suffix}@example.com`,name:role,emailVerified:true,status:'ACTIVE',preferredLanguage:'en',updatedAt:new Date()}});const session=await db.session.create({data:{id:randomUUID(),userId:u.id,token:randomUUID(),expiresAt:new Date(Date.now()+3600000)}});users[role]={id:u.id,sessionId:session.id}}
 const f=await seedBrowserProductionFixture(env.connectionString,suffix);const membership=await db.organizationMember.findFirstOrThrow({where:{organizationId:f.operatorOrganizationId,userId:users.operator.id}});await db.membershipRole.create({data:{membershipId:membership.id,role:'PRODUCTION_MANAGER',assignedByUserId:users.operator.id}});const profile=await db.artisanProfile.findUniqueOrThrow({where:{userId:users.artisan.id}});await offers.assess(users.operator,f.orderId,{version:1,restrictionsReviewed:true,restrictionSource:'Synthetic test only'},randomUUID());
 const assessment=await db.eligibilityAssessment.findFirstOrThrow({where:{orderId:f.orderId,artisanProfileId:profile.id},orderBy:{version:'desc'}});assert.equal(assessment.decision,'ELIGIBLE');const cap=await db.capacityDeclaration.findFirstOrThrow({where:{artisanProfileId:profile.id}});return {f,users,profile,assessment,cap}
}
async function prepare(x:any,quantity:number){const order=await db.commercialOrder.findUniqueOrThrow({where:{id:x.f.orderId}});return offers.createOffer(x.users.operator,x.f.orderId,{version:order.version,eligibilityId:x.assessment.id,quantity,expiresAt:'2027-09-20T00:00:00Z',materials:'Synthetic operator supplies materials',reworkTerms:'Review required, no automatic deduction',paymentConditions:'Synthetic QA-approved terms',collectionArrangement:'Synthetic hub',instructions:'Synthetic weaving instructions'},randomUUID())}
async function issue(x:any,o:any){return offers.issue(x.users.operator,o.id,{version:o.version},randomUUID())}
async function accept(x:any,o:any,key=randomUUID()){return commerce.offerAction(x.users.artisan,o.id,{next:'ACCEPTED',version:o.version,termsSha256:o.termsSha256,reviewLanguage:'en',sourceTermsLanguage:'en',acknowledgeOriginalTerms:true},key)}
try{
 {const x=await fixture('audit-full');const o=await issue(x,await prepare(x,50));const rejected=await result(()=>accept(x,o));assert.equal(rejected.ok,false);assert.equal(rejected.code,'ELIGIBILITY_STALE');assert.match(rejected.message,/CAPACITY_EXCEEDED/);results.push({case:'valid fully reserved50of50 acceptance',...rejected});
 const declined=await commerce.offerAction(x.users.artisan,o.id,{next:'DECLINED',version:o.version,termsSha256:o.termsSha256},randomUUID());const cap=await projectCapacity(db as never,x.cap);assert.equal(cap.reserved,'0.00');results.push({case:'decline releases reservation',reserved:cap.reserved,version:declined.version});}
 {const x=await fixture('audit-room');await db.capacityDeclaration.update({where:{id:x.cap.id},data:{quantity:100}});const o=await issue(x,await prepare(x,40));const key=randomUUID();const rs=await Promise.all([accept(x,o,key),accept(x,o,key)]);assert.deepEqual(rs[0],rs[1]);assert.equal(await db.commercialBatch.count({where:{offerId:o.id}}),1);results.push({case:'valid acceptance with spare capacity concurrent keyed replay',accepted:true,batches:1,sameResult:true});}
 {const x=await fixture('audit-short');const o=await issue(x,await prepare(x,50));await db.capacityDeclaration.update({where:{id:x.cap.id},data:{quantity:30}});const denied=await result(()=>accept(x,o));assert.equal(denied.ok,false);results.push({case:'insufficient changed capacity',...denied});}
 {const x=await fixture('audit-expire');const o=await issue(x,await prepare(x,50));await db.commercialOffer.update({where:{id:o.id},data:{expiresAt:new Date(0)}});const denied=await result(()=>accept(x,o));assert.equal(denied.ok,false);await commerce.offerAction(x.users.operator,o.id,{next:'EXPIRED',version:o.version},randomUUID());const cap=await projectCapacity(db as never,x.cap);assert.equal(cap.reserved,'0.00');results.push({case:'expired acceptance denied and expiry releases reservation',denial:denied,reserved:cap.reserved});}
 {const x=await fixture('audit-craft');const unrelated=await db.craftSkill.upsert({where:{name:'Synthetic unrelated audit craft'},create:{name:'Synthetic unrelated audit craft',category:'TEXTILE'},update:{}});await db.artisanSkill.create({data:{artisanProfileId:x.profile.id,craftSkillId:unrelated.id}});await db.artisanSkill.deleteMany({where:{artisanProfileId:x.profile.id,craftSkillId:'weaving'}});
 const o=await prepare(x,10);const issued=await issue(x,o);const accepted=await accept(x,issued);assert.equal((await db.commercialOffer.findUniqueOrThrow({where:{id:o.id}})).status,'ACCEPTED');
 const plan=await db.allocationPlan.create({data:{orderId:x.f.orderId,version:1,state:'DRAFT',requiredQuantity:100,materialAssumptions:{readiness:'READY',reference:'Synthetic only'},policyVersion:1,authorId:x.users.operator.id,items:{create:{artisanProfileId:x.profile.id,quantity:10,state:'DRAFT'}}}});
 const override=await result(()=>planning.override(x.users.operator,{planId:plan.id,version:1,artisanProfileId:x.profile.id,quantity:10,reason:'Synthetic audit of stale craft qualification'},randomUUID()));assert.equal(override.ok,true,JSON.stringify(override));const foreign=await result(()=>planning.override(x.users.coordinator,{planId:plan.id,version:2,artisanProfileId:x.profile.id,quantity:10,reason:'Synthetic foreign authorization rejection'},randomUUID()));assert.equal(foreign.ok,false);results.push({case:'requested craft removed unrelated retained',prepared:true,issued:true,accepted:true,overrideAccepted:true,foreignDenied:true,foreignCode:foreign.code});}
 console.log('AUDIT_RESULTS '+JSON.stringify(results,null,2));
}finally{await db.$disconnect();await env.close()}
