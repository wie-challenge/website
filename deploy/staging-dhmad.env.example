# Isolated Felcloud staging configuration for DHMAD sandbox qualification.
# Never point DATABASE_URL at the production database, never use sk_live_ keys,
# and NEVER route sandbox webhooks through the production hostname (nasj-platform.ddns.net).
NODE_ENV=development
PUBLIC_APP_URL=https://staging-dhmad.nasj-platform.ddns.net
API_HOST=127.0.0.1
API_PORT=3002
DATABASE_URL=postgresql://nasj_staging:SET_PRIVATE_STAGING_PASSWORD@127.0.0.1:5433/nasj_dhmad_staging
BETTER_AUTH_SECRET=SET_A_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
TRUST_PROXY=127.0.0.1/32,::1/128
REQUIRE_PRIVILEGED_MFA=true
DEMO_MODE=false
ARCJET_ENABLED=false
LOG_LEVEL=info

# DHMAD Sandbox only (real payouts remain disabled).
PAYMENTS_ENABLED=true
PAYMENT_PROVIDER=dhmad
DHMAD_ENVIRONMENT=sandbox
DHMAD_BASE_URL=https://sandbox.dhmad.tn/api
DHMAD_API_KEY=SET_SANDBOX_KEY_WITH_sk_sandbox_PREFIX
DHMAD_WEBHOOK_SECRET=SET_SANDBOX_WEBHOOK_SECRET
DHMAD_EXPECTED_SELLER_EMAIL=SET_NASJ_SANDBOX_SELLER_EMAIL
DHMAD_CHECKOUT_RETURN_URL=https://staging-dhmad.nasj-platform.ddns.net/orders
PAYMENT_B2C_REVIEW_HOURS=72
PAYMENT_B2B_REVIEW_HOURS=168
PAYMENT_RECONCILIATION_ENABLED=true
ARTISAN_PAYOUT_MODE=simulation
REAL_PAYOUTS_ENABLED=false
