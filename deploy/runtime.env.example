# Install privately as /etc/nasj/runtime.env (root:nasj 0640). Never commit real values.
NODE_ENV=production
PUBLIC_APP_URL=https://nasj-platform.ddns.net
API_HOST=127.0.0.1
API_PORT=3001
DATABASE_URL=postgresql://nasj_app:SET_PRIVATE_PASSWORD@127.0.0.1:5432/nasj
BETTER_AUTH_SECRET=SET_A_RANDOM_SECRET_AT_LEAST_48_CHARACTERS
# Host proxy and Next.js are the only trusted upstreams on loopback.
TRUST_PROXY=127.0.0.1/32,::1/128
REQUIRE_PRIVILEGED_MFA=true
DEMO_MODE=false
ARCJET_ENABLED=true
ARCJET_KEY=SET_PRIVATE_PROVIDER_KEY
ARCJET_MODE=LIVE
ARCJET_FAILURE_MODE=closed
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_REQUIRE_TLS=true
SMTP_USER=SET_PRIVATE_USERNAME
SMTP_PASSWORD=SET_PRIVATE_PASSWORD
EMAIL_FROM=NASJ <noreply@nasj-platform.ddns.net>
NOTIFICATION_EMAIL_ENABLED=false
LOG_LEVEL=info
# Optional assistant stays disabled until its separate broker/worker deployment is reviewed.
ASSISTANT_AMQP_URL=
