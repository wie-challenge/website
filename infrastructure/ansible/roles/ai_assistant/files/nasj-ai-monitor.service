[Unit]
Description=NASJ private assistant health checks
OnFailure=nasj-notify@%n.service

[Service]
Type=oneshot
User=rabbitmq
Group=rabbitmq
ExecStart=/usr/local/libexec/nasj-ai-monitor
StateDirectory=nasj-ai-monitor
TimeoutStartSec=30s
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
UMask=0077
