{
  "name": "@hirfacare/api",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/main.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "node --env-file-if-exists=../../.env dist/main.js",
    "typecheck": "prisma generate && tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "bootstrap-admin": "tsx --env-file=../../.env src/bootstrap-admin.ts",
    "test": "tsx --test test/unit/*.test.ts",
    "test:integration": "tsx test/integration.ts",
    "typecheck:test": "tsc -p tsconfig.test.json",
    "worker": "node --env-file-if-exists=../../.env dist/jobs/main.js"
  },
  "dependencies": {
    "@arcjet/nest": "1.14.1",
    "@hirfacare/contracts": "workspace:*",
    "@nestjs/common": "11.1.28",
    "@nestjs/core": "11.1.28",
    "@nestjs/platform-express": "11.2.6",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "better-auth": "1.7.10",
    "dotenv": "17.4.2",
    "express": "5.2.1",
    "jose": "6.2.12",
    "nodemailer": "10.0.12",
    "pg": "8.22.0",
    "pino": "10.3.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@types/express": "5.0.6",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/smtp-server": "3.5.12",
    "prisma": "7.10.0",
    "smtp-server": "3.18.3"
  }
}
