generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  revisionsAuthored                ProcurementRevision[]       @relation("RevisionAuthor")
  procurementActivities            ProcurementActivity[]       @relation("ActivityActor")
  procurementAttachments           ProcurementAttachment[]     @relation("AttachmentAuthor")
  procurementQuestions             ProcurementQuestion[]       @relation("QuestionAuthor")
  procurementAnswers               ProcurementQuestion[]       @relation("QuestionAnswerer")
  procurementMessages              ProcurementMessage[]        @relation("MessageAuthor")
  procurementSamples               ProcurementSample[]         @relation("SampleAuthor")
  procurementDecisions             ProcurementSampleDecision[] @relation("SampleSignatory")
  procurementQuotes                ProcurementQuote[]          @relation("QuoteAuthor")
  procurementAcceptances           ProcurementAcceptance[]     @relation("QuoteSignatory")
  procurementProducts              ApprovedProductVersion[]    @relation("ProductAuthor")
  procurementDocuments             ProcurementDocument[]       @relation("DocumentAuthor")
  artisanProfilesCreated           ArtisanProfile[]            @relation("ArtisanCreator")
  registryManagements              ArtisanManagement[]         @relation("ManagementRecorder")
  registryAssignmentsGiven         ArtisanAssignment[]         @relation("ArtisanAssigner")
  registryAssignmentsHeld          ArtisanAssignment[]         @relation("ResponsibleCoordinator")
  authorizationPoliciesReviewed    AuthorizationPolicy[]       @relation("PolicyReviewer")
  onboardingAuthorizationsRecorded OnboardingAuthorization[]   @relation("AuthorizationRecorder")
  membershipPermissionsGranted     MembershipPermission[]      @relation("PermissionGrantor")
  operatorAccounts                 OperatorAssignment[]        @relation("Operator")
  operatorAssignmentsGiven         OperatorAssignment[]        @relation("OperatorAssigner")
  concernsReviewed                 ParticipantConcern[]        @relation("ConcernReviewer")
  twoFactorEnabled                 Boolean                     @default(false)
  twoFactor                        TwoFactor?
  id                               String                      @id
  name                             String
  email                            String                      @unique
  emailVerified                    Boolean                     @default(false)
  image                            String?
  createdAt                        DateTime                    @default(now())
  updatedAt                        DateTime                    @updatedAt
  role                             Role                        @default(USER)
  status                           AccountStatus               @default(ACTIVE)
  preferredLanguage                String                      @default("en")
  organizationMemberships          OrganizationMember[]
  artisanProfile                   ArtisanProfile?
  organizationsCreated             Organization[]              @relation("OrganizationCreator")
  organizationsReviewed            Organization[]              @relation("OrganizationReviewer")
  rolesAssigned                    MembershipRole[]            @relation("RoleAssigner")
  invitationsCreated               Invitation[]
  capacityDeclarations             CapacityDeclaration[]
  delegatedGrants                  DelegationGrant[]           @relation("Delegate")
  consents                         ConsentRecord[]
  auditEvents                      AuditEvent[]
  privacyRequests                  PrivacyRequest[]            @relation("PrivacySubject")
  privacyReviews                   PrivacyRequest[]            @relation("PrivacyReviewer")
  notificationPreferences          NotificationPreference[]
  supportCases                     SupportCase[]               @relation("CaseSubject")
  assignedCases                    SupportCase[]               @relation("CaseAssignee")
  sessions                         Session[]
  accounts                         Account[]

  @@index([role, status])
}

model Session {
  mfaVerifiedAt DateTime?
  id            String    @id
  token         String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  ipAddress     String?
  userAgent     String?
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model RateBucket {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@index([resetAt])
}

enum OrganizationType {
  PARTNER_COOPERATIVE
  BUYER_BUSINESS
  ASSOCIATION
  INTERNAL
}

enum ApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  LEFT
}

enum BusinessRole {
  BUYER_REPRESENTATIVE
  nasj_OPERATOR
  BUYER
  ARTISAN
  ASSOCIATION_COORDINATOR
  PRODUCTION_MANAGER
  FINANCE_MANAGER
  QUALITY_INSPECTOR
  INVENTORY_LOGISTICS_COORDINATOR
  SUPPORT
  RESEARCHER_ANALYST
  PRODUCT_DESIGNER
  BUSINESS_DEVELOPMENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

enum AvailabilityStatus {
  AVAILABLE
  PAUSED
}

enum RelationshipStatus {
  ACTIVE
  REVOKED
}

enum DelegationScope {
  PROFILE_READ
  PROFILE_UPDATE
  SKILLS_MANAGE
  CAPACITY_READ
  CAPACITY_UPDATE
}

enum PrivacyRequestType {
  EXPORT
  CORRECTION
  DELETION
}

enum PrivacyRequestStatus {
  SUBMITTED
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Organization {
  managingArtisans       ArtisanManagement[]
  assignedArtisans       ArtisanAssignment[]
  assignedOperators      OperatorAssignment[]
  buyerRfqs              CommercialRfq[]         @relation("RfqBuyer")
  operatorRfqs           CommercialRfq[]         @relation("RfqOperator")
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  type                   OrganizationType
  approvalStatus         ApprovalStatus          @default(DRAFT)
  country                String                  @default("TN")
  region                 String
  description            String
  contactEmail           String
  contactPhone           String?
  representativeName     String
  createdByUserId        String
  createdBy              User                    @relation("OrganizationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedByUserId       String?
  approvedBy             User?                   @relation("OrganizationReviewer", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  approvedAt             DateTime?
  approvalReason         String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  members                OrganizationMember[]
  invitations            Invitation[]
  associationMemberships AssociationMembership[]
  delegations            DelegationGrant[]
  auditEvents            AuditEvent[]
  supportCases           SupportCase[]

  @@index([approvalStatus, createdAt])
}

model OrganizationMember {
  id               String                 @id @default(cuid())
  organizationId   String
  organization     Organization           @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId           String
  user             User                   @relation(fields: [userId], references: [id], onDelete: Restrict)
  status           MembershipStatus       @default(ACTIVE)
  isManager        Boolean                @default(false)
  joinedAt         DateTime               @default(now())
  suspendedAt      DateTime?
  revokedAt        DateTime?
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  roles            MembershipRole[]
  isCoordinator    Boolean                @default(false)
  permissionGrants MembershipPermission[]

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model MembershipRole {
  id               String             @id @default(cuid())
  membershipId     String
  membership       OrganizationMember @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  role             BusinessRole
  assignedByUserId String
  assignedBy       User               @relation("RoleAssigner", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  assignedAt       DateTime           @default(now())

  @@unique([membershipId, role])
}

model Invitation {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email           String
  tokenHash       String           @unique
  roles           BusinessRole[]
  isManager       Boolean          @default(false)
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdByUserId String
  createdBy       User             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([organizationId, status])
  @@index([email, status])
}

model ArtisanProfile {
  createdBy             User?                     @relation("ArtisanCreator", fields: [createdById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ArtisanProfile_createdById_fk")
  createdById           String?
  participantStatus     String                    @default("ACTIVE")
  managements           ArtisanManagement[]
  assignments           ArtisanAssignment[]
  authorizations        OnboardingAuthorization[]
  commercialOffers      CommercialOffer[]
  commercialBatches     CommercialBatch[]
  id                    String                    @id @default(cuid())
  userId                String?                   @unique
  user                  User?                     @relation(fields: [userId], references: [id], onDelete: Restrict)
  displayName           String
  region                String
  preferredLanguage     String                    @default("en")
  contactPhone          String?
  contactVisibility     String                    @default("PRIVATE")
  availabilityStatus    AvailabilityStatus        @default(AVAILABLE)
  experienceDescription String                    @default("")
  equipment             String[]
  createdAt             DateTime                  @default(now())
  updatedAt             DateTime                  @updatedAt
  skills                ArtisanSkill[]
  capacityDeclarations  CapacityDeclaration[]
  associations          AssociationMembership[]
  delegations           DelegationGrant[]
}

model CraftSkill {
  rfqs        CommercialRfq[]
  id          String                @id @default(cuid())
  name        String                @unique
  category    String
  description String                @default("")
  isActive    Boolean               @default(true)
  artisans    ArtisanSkill[]
  capacities  CapacityDeclaration[]
}

model ArtisanSkill {
  id               String         @id @default(cuid())
  artisanProfileId String
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  craftSkillId     String
  craftSkill       CraftSkill     @relation(fields: [craftSkillId], references: [id], onDelete: Restrict)
  proficiency      String?
  evidence         String?

  @@unique([artisanProfileId, craftSkillId])
  @@index([craftSkillId])
}

model CapacityDeclaration {
  authorization    OnboardingAuthorization? @relation(fields: [authorizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "CapacityDeclaration_authorizationId_fk")
  authorizationId  String?
  commercialOffers CommercialOffer[]
  supersededAt     DateTime?
  id               String                   @id @default(cuid())
  artisanProfileId String
  artisanProfile   ArtisanProfile           @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  craftSkillId     String
  craftSkill       CraftSkill               @relation(fields: [craftSkillId], references: [id], onDelete: Restrict)
  unitType         String
  quantity         Decimal                  @db.Decimal(12, 2)
  effectiveFrom    DateTime
  effectiveTo      DateTime
  declaredByUserId String
  declaredBy       User                     @relation(fields: [declaredByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime                 @default(now())

  @@index([artisanProfileId, effectiveFrom])
}

model AssociationMembership {
  id               String             @id @default(cuid())
  artisanProfileId String
  artisanProfile   ArtisanProfile     @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  status           RelationshipStatus @default(ACTIVE)
  consentRecordId  String
  consentRecord    ConsentRecord      @relation(fields: [consentRecordId], references: [id], onDelete: Restrict)
  startedAt        DateTime           @default(now())
  endedAt          DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([artisanProfileId, organizationId])
  @@index([organizationId, status])
}

model DelegationGrant {
  id               String             @id @default(cuid())
  artisanProfileId String
  artisanProfile   ArtisanProfile     @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  delegateUserId   String
  delegate         User               @relation("Delegate", fields: [delegateUserId], references: [id], onDelete: Restrict)
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  scopes           DelegationScope[]
  status           RelationshipStatus @default(ACTIVE)
  grantedAt        DateTime           @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime           @default(now())

  @@index([artisanProfileId, delegateUserId, status])
  @@index([organizationId])
}

model ConsentRecord {
  id                     String                  @id @default(cuid())
  userId                 String
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  purpose                String
  policyVersion          String
  decision               Boolean
  collectedAt            DateTime                @default(now())
  withdrawnAt            DateTime?
  collectionContext      String
  associationMemberships AssociationMembership[]

  @@index([userId, purpose])
}

model AuditEvent {
  id             String        @id @default(cuid())
  actorId        String
  actor          User          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  targetType     String
  targetId       String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  action         String
  timestamp      DateTime      @default(now())
  correlationId  String
  reason         String?
  before         Json?
  after          Json?

  @@index([organizationId, timestamp])
  @@index([actorId, timestamp])
  @@index([targetType, targetId])
}

model PrivacyRequest {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation("PrivacySubject", fields: [userId], references: [id], onDelete: Restrict)
  type                PrivacyRequestType
  status              PrivacyRequestStatus @default(SUBMITTED)
  details             String
  submittedAt         DateTime             @default(now())
  assignedReviewerId  String?
  assignedReviewer    User?                @relation("PrivacyReviewer", fields: [assignedReviewerId], references: [id], onDelete: Restrict)
  resolvedAt          DateTime?
  resolutionNotes     String?
  retentionExceptions String?

  @@index([userId, submittedAt])
  @@index([status, submittedAt])
}

model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  language  String              @default("en")
  channel   NotificationChannel @default(EMAIL)
  category  String
  optedIn   Boolean             @default(false)
  updatedAt DateTime            @updatedAt

  @@unique([userId, channel, category])
}

model SupportCase {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation("CaseSubject", fields: [userId], references: [id], onDelete: Restrict)
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subject          String
  description      String
  status           CaseStatus    @default(OPEN)
  assignedToUserId String?
  assignedTo       User?         @relation("CaseAssignee", fields: [assignedToUserId], references: [id], onDelete: Restrict)
  resolution       String?
  dueAt            DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([organizationId, status])
}

model TwoFactor {
  id                      String    @id
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([secret])
}

// Outcome is committed atomically with the authorized capacity mutation.
model CommandOutcome {
  id          String   @id @default(cuid())
  actorId     String
  resourceId  String
  operation   String
  keyHash     String
  payloadHash String
  result      Json
  createdAt   DateTime @default(now())

  @@unique([actorId, resourceId, operation, keyHash])
}

enum OutboxStatus {
  PENDING
  RETRY
  DELIVERED
  FAILED
}

// Metadata only: never copy user-entered text, audit snapshots or wearable data.
model OutboxEvent {
  id             String           @id
  auditEventId   String           @unique
  eventType      String
  version        Int              @default(1)
  actorId        String
  organizationId String?
  targetType     String
  targetId       String
  correlationId  String
  createdAt      DateTime         @default(now())
  status         OutboxStatus     @default(PENDING)
  attempts       Int              @default(0)
  availableAt    DateTime         @default(now())
  deliveredAt    DateTime?
  lastErrorCode  String?
  durationMs     Int?
  notices        CommerceNotice[]
  receipt        EventReceipt?

  @@index([status, availableAt])
}

// Internal durable consumer; not evidence of external publication or commerce ETL.
model EventReceipt {
  eventId    String      @id
  event      OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict)
  receivedAt DateTime    @default(now())
}

model CommercialRfq {
  revisions              ProcurementRevision[]
  activities             ProcurementActivity[]
  attachments            ProcurementAttachment[]
  questions              ProcurementQuestion[]
  messages               ProcurementMessage[]
  samples                ProcurementSample[]
  quotes                 ProcurementQuote[]
  products               ApprovedProductVersion[] @relation("ProductSource")
  documents              ProcurementDocument[]
  procurementManaged     Boolean                  @default(false)
  sourceProductId        String?
  sourceProduct          ApprovedProductVersion?  @relation("ReorderSource", fields: [sourceProductId], references: [id], onDelete: Restrict)
  id                     String                   @id @default(cuid())
  buyerOrganizationId    String
  buyerOrganization      Organization             @relation("RfqBuyer", fields: [buyerOrganizationId], references: [id], onDelete: Restrict)
  operatorOrganizationId String
  operatorOrganization   Organization             @relation("RfqOperator", fields: [operatorOrganizationId], references: [id], onDelete: Restrict)
  craftSkillId           String
  craftSkill             CraftSkill               @relation(fields: [craftSkillId], references: [id], onDelete: Restrict)
  title                  String
  specification          String
  designRequirements     String
  quantity               Int
  deliveryAt             DateTime
  deliveryLocation       String
  status                 String                   @default("DRAFT")
  version                Int                      @default(1)
  provenance             String                   @default("SYNTHETIC")
  quoteMillimes          BigInt?
  quoteExpiresAt         DateTime?
  createdAt              DateTime                 @default(now())
  updatedAt              DateTime                 @updatedAt
  order                  CommercialOrder?

  @@index([buyerOrganizationId, createdAt])
  @@index([operatorOrganizationId, status])
}

model CommercialOrder {
  products          ApprovedProductVersion[]
  documents         ProcurementDocument[]
  acceptance        ProcurementAcceptance?
  projection        CommerceProjection?
  id                String                   @id @default(cuid())
  rfqId             String                   @unique
  rfq               CommercialRfq            @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  status            String                   @default("APPROVED")
  version           Int                      @default(1)
  delivered         Int                      @default(0)
  materialsResolved Boolean                  @default(false)
  dispositionNote   String?
  provenance        String                   @default("SYNTHETIC")
  createdAt         DateTime                 @default(now())
  offers            CommercialOffer[]
  batches           CommercialBatch[]
  payments          SyntheticPayment[]
}

model CommercialOffer {
  id                    String              @id @default(cuid())
  orderId               String
  order                 CommercialOrder     @relation(fields: [orderId], references: [id], onDelete: Restrict)
  capacityDeclarationId String
  capacityDeclaration   CapacityDeclaration @relation(fields: [capacityDeclarationId], references: [id], onDelete: Restrict)
  artisanProfileId      String
  artisanProfile        ArtisanProfile      @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  quantity              Int
  unitPayMillimes       BigInt
  estimatedHours        String
  expiresAt             DateTime
  materials             String
  reworkTerms           String
  paymentConditions     String
  status                String              @default("PLANNED")
  version               Int                 @default(1)
  provenance            String              @default("SYNTHETIC")
  acceptedAt            DateTime?
  decidedByUserId       String?
  createdAt             DateTime            @default(now())
  batch                 CommercialBatch?

  @@index([orderId, status])
  @@index([artisanProfileId, status])
  @@index([capacityDeclarationId, status])
}

model CommercialBatch {
  id               String                 @id @default(cuid())
  orderId          String
  order            CommercialOrder        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  offerId          String                 @unique
  offer            CommercialOffer        @relation(fields: [offerId], references: [id], onDelete: Restrict)
  artisanProfileId String
  artisanProfile   ArtisanProfile         @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  status           String                 @default("ACCEPTED")
  version          Int                    @default(1)
  produced         Int                    @default(0)
  submitted        Int                    @default(0)
  approved         Int                    @default(0)
  rejected         Int                    @default(0)
  pending          Int                    @default(0)
  provenance       String                 @default("SYNTHETIC")
  createdAt        DateTime               @default(now())
  inspections      CommercialInspection[]
  payments         SyntheticPayment[]

  @@index([orderId])
  @@index([artisanProfileId, status])
}

model CommercialInspection {
  id           String          @id @default(cuid())
  batchId      String
  batch        CommercialBatch @relation(fields: [batchId], references: [id], onDelete: Restrict)
  batchVersion Int
  inspectorId  String
  approved     Int
  rejected     Int
  pending      Int
  submitted    Int
  defectReason String
  createdAt    DateTime        @default(now())

  @@unique([batchId, batchVersion])
}

model SyntheticPayment {
  id             String           @id @default(cuid())
  orderId        String
  order          CommercialOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  batchId        String?
  batch          CommercialBatch? @relation(fields: [batchId], references: [id], onDelete: Restrict)
  kind           String
  amountMillimes BigInt
  status         String           @default("SCHEDULED")
  version        Int              @default(1)
  provenance     String           @default("SYNTHETIC")
  evidenceType   String?
  createdAt      DateTime         @default(now())

  @@index([orderId, kind, status])
  @@index([batchId, status])
}

// Rebuildable derived values only. No user-entered text or wearable data.
model CommerceProjection {
  orderId           String          @id
  order             CommercialOrder @relation(fields: [orderId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  definitionVersion Int             @default(1)
  asOf              DateTime        @default(now())
  metrics           Json
}

// Static event-code inbox. Scope is a buyer/internal organization or artisan account.
model CommerceNotice {
  id        String      @id @default(cuid())
  eventId   String
  event     OutboxEvent @relation(fields: [eventId], references: [id], onDelete: Restrict, onUpdate: NoAction)
  audience  String
  scopeId   String
  code      String
  createdAt DateTime    @default(now())

  @@unique([eventId, audience, scopeId])
  @@index([audience, scopeId, createdAt])
}

// Explicit authority, never inferred from a buyer finance job title.
model MembershipPermission {
  enabled      Boolean            @default(true)
  grantedBy    User               @relation("PermissionGrantor", fields: [grantedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "MembershipPermission_grantedById_fk")
  id           String             @id @default(cuid())
  membershipId String
  membership   OrganizationMember @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  permission   String
  grantedById  String
  reason       String
  createdAt    DateTime           @default(now())

  @@unique([membershipId, permission])
}

model ArtisanManagement {
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ArtisanManagement_organizationId_fk")
  recordedBy       User           @relation("ManagementRecorder", fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ArtisanManagement_recordedById_fk")
  id               String         @id @default(cuid())
  artisanProfileId String
  artisan          ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  organizationId   String
  startedAt        DateTime       @default(now())
  endedAt          DateTime?
  reason           String
  recordedById     String

  @@index([organizationId, endedAt])
  @@index([artisanProfileId, endedAt])
}

model ArtisanAssignment {
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ArtisanAssignment_organizationId_fk")
  coordinator      User           @relation("ResponsibleCoordinator", fields: [coordinatorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ArtisanAssignment_coordinatorId_fk")
  assignedBy       User           @relation("ArtisanAssigner", fields: [assignedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ArtisanAssignment_assignedById_fk")
  id               String         @id @default(cuid())
  artisanProfileId String
  artisan          ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  coordinatorId    String
  organizationId   String
  assignedById     String
  startedAt        DateTime       @default(now())
  endedAt          DateTime?
  reason           String

  @@index([coordinatorId, organizationId, endedAt])
}

model AuthorizationPolicy {
  reviewedBy      User                      @relation("PolicyReviewer", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "AuthorizationPolicy_reviewedById_fk")
  id              String                    @id @default(cuid())
  version         String                    @unique
  methods         String[]
  reviewReference String
  reviewedById    String
  active          Boolean                   @default(true)
  createdAt       DateTime                  @default(now())
  authorizations  OnboardingAuthorization[]
}

model OnboardingAuthorization {
  recordedBy           User                  @relation("AuthorizationRecorder", fields: [recordedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "OnboardingAuthorization_recordedById_fk")
  capacityDeclarations CapacityDeclaration[]
  id                   String                @id @default(cuid())
  artisanProfileId     String
  artisan              ArtisanProfile        @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  policyId             String
  policy               AuthorizationPolicy   @relation(fields: [policyId], references: [id], onDelete: Restrict)
  purpose              String
  method               String
  occurredAt           DateTime
  language             String
  recordedById         String
  witnessReference     String?
  evidenceReference    String
  withdrawnAt          DateTime?
  withdrawalReason     String?
  createdAt            DateTime              @default(now())

  @@index([artisanProfileId, purpose, withdrawnAt])
}

model OperatorAssignment {
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "OperatorAssignment_organizationId_fk")
  operator       User         @relation("Operator", fields: [operatorId], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "OperatorAssignment_operatorId_fk")
  assignedBy     User         @relation("OperatorAssigner", fields: [assignedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "OperatorAssignment_assignedById_fk")
  id             String       @id @default(cuid())
  operatorId     String
  organizationId String
  assignedById   String
  createdAt      DateTime     @default(now())
  revokedAt      DateTime?

  @@unique([operatorId, organizationId])
}

// Accessible independent intake; no login or fake User is created for a participant.
model ParticipantConcern {
  reviewedBy       User?     @relation("ConcernReviewer", fields: [reviewedById], references: [id], onDelete: Restrict, onUpdate: NoAction, map: "ParticipantConcern_reviewedById_fkey")
  id               String    @id @default(cuid())
  subjectReference String
  concernType      String
  description      String
  contactMethod    String?
  status           String    @default("OPEN")
  reviewedById     String?
  resolution       String?
  createdAt        DateTime  @default(now())
  reviewedAt       DateTime?

  @@index([status, createdAt])
}

model ProcurementRevision {
  id            String               @id @default(cuid())
  rfqId         String
  rfq           CommercialRfq        @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  version       Int
  authorId      String
  author        User                 @relation("RevisionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  reason        String
  predecessorId String?              @unique
  predecessor   ProcurementRevision? @relation("RevisionChain", fields: [predecessorId], references: [id], onDelete: Restrict)
  successor     ProcurementRevision? @relation("RevisionChain")
  snapshot      Json
  createdAt     DateTime             @default(now())
  quotes        ProcurementQuote[]
  samples       ProcurementSample[]

  @@unique([rfqId, version])
}

model ProcurementActivity {
  id         String        @id @default(cuid())
  rfqId      String
  rfq        CommercialRfq @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  actorId    String
  actor      User          @relation("ActivityActor", fields: [actorId], references: [id], onDelete: Restrict)
  actorLabel String
  code       String
  version    Int
  createdAt  DateTime      @default(now())

  @@index([rfqId, createdAt, id])
}

model ProcurementAttachment {
  id        String        @id @default(cuid())
  rfqId     String
  rfq       CommercialRfq @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  authorId  String
  author    User          @relation("AttachmentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  filename  String
  mime      String
  bytes     Bytes
  sha256    String
  removedAt DateTime?
  createdAt DateTime      @default(now())

  @@index([rfqId, removedAt])
}

model ProcurementQuestion {
  id           String        @id @default(cuid())
  rfqId        String
  rfq          CommercialRfq @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  authorId     String
  author       User          @relation("QuestionAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  question     String
  answer       String?
  answeredById String?
  answeredBy   User?         @relation("QuestionAnswerer", fields: [answeredById], references: [id], onDelete: Restrict)
  createdAt    DateTime      @default(now())
  answeredAt   DateTime?

  @@index([rfqId, createdAt])
}

model ProcurementMessage {
  id          String        @id @default(cuid())
  rfqId       String
  rfq         CommercialRfq @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  authorId    String
  author      User          @relation("MessageAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  authorLabel String
  body        String
  internal    Boolean       @default(false)
  createdAt   DateTime      @default(now())

  @@index([rfqId, internal, createdAt, id])
}

model ProcurementSample {
  id                String                     @id @default(cuid())
  rfqId             String
  rfq               CommercialRfq              @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  version           Int
  revisionId        String
  revision          ProcurementRevision        @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  authorId          String
  author            User                       @relation("SampleAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  evidenceReference String
  criteria          String
  snapshot          Json
  createdAt         DateTime                   @default(now())
  decision          ProcurementSampleDecision?
  products          ApprovedProductVersion[]

  @@unique([rfqId, version])
}

model ProcurementSampleDecision {
  id        String            @id @default(cuid())
  sampleId  String            @unique
  sample    ProcurementSample @relation(fields: [sampleId], references: [id], onDelete: Restrict)
  actorId   String
  actor     User              @relation("SampleSignatory", fields: [actorId], references: [id], onDelete: Restrict)
  decision  String
  comments  String
  createdAt DateTime          @default(now())
}

model ProcurementQuote {
  id            String                 @id @default(cuid())
  rfqId         String
  rfq           CommercialRfq          @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  version       Int
  revisionId    String
  revision      ProcurementRevision    @relation(fields: [revisionId], references: [id], onDelete: Restrict)
  authorId      String
  author        User                   @relation("QuoteAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  totalMillimes BigInt
  expiresAt     DateTime
  snapshot      Json
  createdAt     DateTime               @default(now())
  acceptance    ProcurementAcceptance?

  @@unique([rfqId, version])
}

model ProcurementAcceptance {
  id        String           @id @default(cuid())
  quoteId   String           @unique
  quote     ProcurementQuote @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  orderId   String           @unique
  order     CommercialOrder  @relation(fields: [orderId], references: [id], onDelete: Restrict)
  actorId   String
  actor     User             @relation("QuoteSignatory", fields: [actorId], references: [id], onDelete: Restrict)
  snapshot  Json
  createdAt DateTime         @default(now())
}

model ApprovedProductVersion {
  id                  String            @id @default(cuid())
  sourceRfqId         String
  sourceRfq           CommercialRfq     @relation("ProductSource", fields: [sourceRfqId], references: [id], onDelete: Restrict)
  sourceOrderId       String
  sourceOrder         CommercialOrder   @relation(fields: [sourceOrderId], references: [id], onDelete: Restrict)
  sampleId            String
  sample              ProcurementSample @relation(fields: [sampleId], references: [id], onDelete: Restrict)
  authorId            String
  author              User              @relation("ProductAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  productCode         String
  version             Int
  status              String            @default("ACTIVE")
  snapshot            Json
  materials           String
  leadTimeDays        Int
  leadTimeSampleCount Int
  leadTimeContext     String
  createdAt           DateTime          @default(now())
  requests            CommercialRfq[]   @relation("ReorderSource")

  @@unique([sourceRfqId, productCode, version])
  @@index([sourceRfqId, status])
}

model ProcurementDocument {
  id        String           @id @default(cuid())
  number    Int              @unique @default(autoincrement())
  rfqId     String
  rfq       CommercialRfq    @relation(fields: [rfqId], references: [id], onDelete: Restrict)
  orderId   String?
  order     CommercialOrder? @relation(fields: [orderId], references: [id], onDelete: Restrict)
  authorId  String
  author    User             @relation("DocumentAuthor", fields: [authorId], references: [id], onDelete: Restrict)
  kind      String
  version   Int
  status    String           @default("FINAL")
  content   Json
  createdAt DateTime         @default(now())

  @@unique([rfqId, kind, version])
}
