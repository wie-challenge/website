generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  USER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  DISABLED
}

model User {
  twoFactorEnabled        Boolean                  @default(false)
  twoFactor               TwoFactor?
  id                      String                   @id
  name                    String
  email                   String                   @unique
  emailVerified           Boolean                  @default(false)
  image                   String?
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt
  role                    Role                     @default(USER)
  status                  AccountStatus            @default(ACTIVE)
  preferredLanguage       String                   @default("en")
  organizationMemberships OrganizationMember[]
  artisanProfile          ArtisanProfile?
  organizationsCreated    Organization[]           @relation("OrganizationCreator")
  organizationsReviewed   Organization[]           @relation("OrganizationReviewer")
  rolesAssigned           MembershipRole[]         @relation("RoleAssigner")
  invitationsCreated      Invitation[]
  capacityDeclarations    CapacityDeclaration[]
  delegatedGrants         DelegationGrant[]        @relation("Delegate")
  consents                ConsentRecord[]
  auditEvents             AuditEvent[]
  privacyRequests         PrivacyRequest[]         @relation("PrivacySubject")
  privacyReviews          PrivacyRequest[]         @relation("PrivacyReviewer")
  notificationPreferences NotificationPreference[]
  supportCases            SupportCase[]            @relation("CaseSubject")
  assignedCases           SupportCase[]            @relation("CaseAssignee")
  sessions                Session[]
  accounts                Account[]

  @@index([role, status])
}

model Session {
  mfaVerifiedAt DateTime?
  id            String    @id
  token         String    @unique
  expiresAt     DateTime
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  ipAddress     String?
  userAgent     String?
  userId        String
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@index([expiresAt])
}

model RateBucket {
  key     String   @id
  count   Int      @default(1)
  resetAt DateTime

  @@index([resetAt])
}

enum OrganizationType {
  BUYER_BUSINESS
  ASSOCIATION
  INTERNAL
}

enum ApprovalStatus {
  DRAFT
  PENDING_REVIEW
  APPROVED
  REJECTED
  SUSPENDED
}

enum MembershipStatus {
  ACTIVE
  SUSPENDED
  REVOKED
  LEFT
}

enum BusinessRole {
  BUYER
  ARTISAN
  ASSOCIATION_COORDINATOR
  PRODUCTION_MANAGER
  FINANCE_MANAGER
  QUALITY_INSPECTOR
  INVENTORY_LOGISTICS_COORDINATOR
  SUPPORT
  RESEARCHER_ANALYST
  PRODUCT_DESIGNER
  BUSINESS_DEVELOPMENT
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  CANCELLED
}

enum AvailabilityStatus {
  AVAILABLE
  PAUSED
}

enum RelationshipStatus {
  ACTIVE
  REVOKED
}

enum DelegationScope {
  PROFILE_READ
  PROFILE_UPDATE
  SKILLS_MANAGE
  CAPACITY_READ
  CAPACITY_UPDATE
}

enum PrivacyRequestType {
  EXPORT
  CORRECTION
  DELETION
}

enum PrivacyRequestStatus {
  SUBMITTED
  IN_REVIEW
  RESOLVED
  REJECTED
}

enum NotificationChannel {
  EMAIL
}

enum CaseStatus {
  OPEN
  IN_PROGRESS
  RESOLVED
}

model Organization {
  id                     String                  @id @default(cuid())
  name                   String
  slug                   String                  @unique
  type                   OrganizationType
  approvalStatus         ApprovalStatus          @default(DRAFT)
  country                String                  @default("TN")
  region                 String
  description            String
  contactEmail           String
  contactPhone           String?
  representativeName     String
  createdByUserId        String
  createdBy              User                    @relation("OrganizationCreator", fields: [createdByUserId], references: [id], onDelete: Restrict)
  approvedByUserId       String?
  approvedBy             User?                   @relation("OrganizationReviewer", fields: [approvedByUserId], references: [id], onDelete: Restrict)
  approvedAt             DateTime?
  approvalReason         String?
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  members                OrganizationMember[]
  invitations            Invitation[]
  associationMemberships AssociationMembership[]
  delegations            DelegationGrant[]
  auditEvents            AuditEvent[]
  supportCases           SupportCase[]

  @@index([approvalStatus, createdAt])
}

model OrganizationMember {
  id             String           @id @default(cuid())
  organizationId String
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  userId         String
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)
  status         MembershipStatus @default(ACTIVE)
  isManager      Boolean          @default(false)
  joinedAt       DateTime         @default(now())
  suspendedAt    DateTime?
  revokedAt      DateTime?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt
  roles          MembershipRole[]

  @@unique([organizationId, userId])
  @@index([userId, status])
}

model MembershipRole {
  id               String             @id @default(cuid())
  membershipId     String
  membership       OrganizationMember @relation(fields: [membershipId], references: [id], onDelete: Restrict)
  role             BusinessRole
  assignedByUserId String
  assignedBy       User               @relation("RoleAssigner", fields: [assignedByUserId], references: [id], onDelete: Restrict)
  assignedAt       DateTime           @default(now())

  @@unique([membershipId, role])
}

model Invitation {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  email           String
  tokenHash       String           @unique
  roles           BusinessRole[]
  isManager       Boolean          @default(false)
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  acceptedAt      DateTime?
  createdByUserId String
  createdBy       User             @relation(fields: [createdByUserId], references: [id], onDelete: Restrict)
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  @@index([organizationId, status])
  @@index([email, status])
}

model ArtisanProfile {
  id                    String                  @id @default(cuid())
  userId                String                  @unique
  user                  User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  displayName           String
  region                String
  preferredLanguage     String                  @default("en")
  contactPhone          String?
  contactVisibility     String                  @default("PRIVATE")
  availabilityStatus    AvailabilityStatus      @default(AVAILABLE)
  experienceDescription String                  @default("")
  equipment             String[]
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  skills                ArtisanSkill[]
  capacityDeclarations  CapacityDeclaration[]
  associations          AssociationMembership[]
  delegations           DelegationGrant[]
}

model CraftSkill {
  id          String                @id @default(cuid())
  name        String                @unique
  category    String
  description String                @default("")
  isActive    Boolean               @default(true)
  artisans    ArtisanSkill[]
  capacities  CapacityDeclaration[]
}

model ArtisanSkill {
  id               String         @id @default(cuid())
  artisanProfileId String
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  craftSkillId     String
  craftSkill       CraftSkill     @relation(fields: [craftSkillId], references: [id], onDelete: Restrict)
  proficiency      String?
  evidence         String?

  @@unique([artisanProfileId, craftSkillId])
  @@index([craftSkillId])
}

model CapacityDeclaration {
  supersededAt     DateTime?
  id               String         @id @default(cuid())
  artisanProfileId String
  artisanProfile   ArtisanProfile @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  craftSkillId     String
  craftSkill       CraftSkill     @relation(fields: [craftSkillId], references: [id], onDelete: Restrict)
  unitType         String
  quantity         Decimal        @db.Decimal(12, 2)
  effectiveFrom    DateTime
  effectiveTo      DateTime
  declaredByUserId String
  declaredBy       User           @relation(fields: [declaredByUserId], references: [id], onDelete: Restrict)
  createdAt        DateTime       @default(now())

  @@index([artisanProfileId, effectiveFrom])
}

model AssociationMembership {
  id               String             @id @default(cuid())
  artisanProfileId String
  artisanProfile   ArtisanProfile     @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  status           RelationshipStatus @default(ACTIVE)
  consentRecordId  String
  consentRecord    ConsentRecord      @relation(fields: [consentRecordId], references: [id], onDelete: Restrict)
  startedAt        DateTime           @default(now())
  endedAt          DateTime?
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt

  @@unique([artisanProfileId, organizationId])
  @@index([organizationId, status])
}

model DelegationGrant {
  id               String             @id @default(cuid())
  artisanProfileId String
  artisanProfile   ArtisanProfile     @relation(fields: [artisanProfileId], references: [id], onDelete: Restrict)
  delegateUserId   String
  delegate         User               @relation("Delegate", fields: [delegateUserId], references: [id], onDelete: Restrict)
  organizationId   String
  organization     Organization       @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  scopes           DelegationScope[]
  status           RelationshipStatus @default(ACTIVE)
  grantedAt        DateTime           @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  createdAt        DateTime           @default(now())

  @@index([artisanProfileId, delegateUserId, status])
  @@index([organizationId])
}

model ConsentRecord {
  id                     String                  @id @default(cuid())
  userId                 String
  user                   User                    @relation(fields: [userId], references: [id], onDelete: Restrict)
  purpose                String
  policyVersion          String
  decision               Boolean
  collectedAt            DateTime                @default(now())
  withdrawnAt            DateTime?
  collectionContext      String
  associationMemberships AssociationMembership[]

  @@index([userId, purpose])
}

model AuditEvent {
  id             String        @id @default(cuid())
  actorId        String
  actor          User          @relation(fields: [actorId], references: [id], onDelete: Restrict)
  targetType     String
  targetId       String
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  action         String
  timestamp      DateTime      @default(now())
  correlationId  String
  reason         String?
  before         Json?
  after          Json?

  @@index([organizationId, timestamp])
  @@index([actorId, timestamp])
  @@index([targetType, targetId])
}

model PrivacyRequest {
  id                  String               @id @default(cuid())
  userId              String
  user                User                 @relation("PrivacySubject", fields: [userId], references: [id], onDelete: Restrict)
  type                PrivacyRequestType
  status              PrivacyRequestStatus @default(SUBMITTED)
  details             String
  submittedAt         DateTime             @default(now())
  assignedReviewerId  String?
  assignedReviewer    User?                @relation("PrivacyReviewer", fields: [assignedReviewerId], references: [id], onDelete: Restrict)
  resolvedAt          DateTime?
  resolutionNotes     String?
  retentionExceptions String?

  @@index([userId, submittedAt])
  @@index([status, submittedAt])
}

model NotificationPreference {
  id        String              @id @default(cuid())
  userId    String
  user      User                @relation(fields: [userId], references: [id], onDelete: Restrict)
  language  String              @default("en")
  channel   NotificationChannel @default(EMAIL)
  category  String
  optedIn   Boolean             @default(false)
  updatedAt DateTime            @updatedAt

  @@unique([userId, channel, category])
}

model SupportCase {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation("CaseSubject", fields: [userId], references: [id], onDelete: Restrict)
  organizationId   String?
  organization     Organization? @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  subject          String
  description      String
  status           CaseStatus    @default(OPEN)
  assignedToUserId String?
  assignedTo       User?         @relation("CaseAssignee", fields: [assignedToUserId], references: [id], onDelete: Restrict)
  resolution       String?
  dueAt            DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  @@index([userId, createdAt])
  @@index([organizationId, status])
}

model TwoFactor {
  id                      String    @id
  userId                  String    @unique
  user                    User      @relation(fields: [userId], references: [id], onDelete: Restrict)
  secret                  String
  backupCodes             String
  verified                Boolean   @default(true)
  failedVerificationCount Int       @default(0)
  lockedUntil             DateTime?

  @@index([secret])
}
